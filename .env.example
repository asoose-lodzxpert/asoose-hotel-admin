# Server-only URL for the Asoose backend, without a trailing slash.
# When omitted, the app runs with local preview data for UI development.
ASOOSE_API_BASE_URL=https://api.example.com

# Browser-visible Google Maps JavaScript API key. Restrict this key to your
# production domains and enable Maps JavaScript API + Places API.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key
