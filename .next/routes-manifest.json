{
  "version": 3,
  "pages404": true,
  "appType": "app",
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "priority": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "onMatchHeaders": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/api/bank-accounts/[bankAccountId]",
      "regex": "^/api/bank\\-accounts/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPbankAccountId": "nxtPbankAccountId"
      },
      "namedRegex": "^/api/bank\\-accounts/(?<nxtPbankAccountId>[^/]+?)(?:/)?$"
    },
    {
      "page": "/api/bookings/[bookingId]",
      "regex": "^/api/bookings/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPbookingId": "nxtPbookingId"
      },
      "namedRegex": "^/api/bookings/(?<nxtPbookingId>[^/]+?)(?:/)?$"
    },
    {
      "page": "/api/bookings/[bookingId]/[action]",
      "regex": "^/api/bookings/([^/]+?)/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPbookingId": "nxtPbookingId",
        "nxtPaction": "nxtPaction"
      },
      "namedRegex": "^/api/bookings/(?<nxtPbookingId>[^/]+?)/(?<nxtPaction>[^/]+?)(?:/)?$"
    },
    {
      "page": "/api/properties/[propertyId]",
      "regex": "^/api/properties/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPpropertyId": "nxtPpropertyId"
      },
      "namedRegex": "^/api/properties/(?<nxtPpropertyId>[^/]+?)(?:/)?$"
    },
    {
      "page": "/api/properties/[propertyId]/room-types",
      "regex": "^/api/properties/([^/]+?)/room\\-types(?:/)?$",
      "routeKeys": {
        "nxtPpropertyId": "nxtPpropertyId"
      },
      "namedRegex": "^/api/properties/(?<nxtPpropertyId>[^/]+?)/room\\-types(?:/)?$"
    },
    {
      "page": "/api/properties/[propertyId]/room-types/[roomTypeId]",
      "regex": "^/api/properties/([^/]+?)/room\\-types/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPpropertyId": "nxtPpropertyId",
        "nxtProomTypeId": "nxtProomTypeId"
      },
      "namedRegex": "^/api/properties/(?<nxtPpropertyId>[^/]+?)/room\\-types/(?<nxtProomTypeId>[^/]+?)(?:/)?$"
    }
  ],
  "staticRoutes": [
